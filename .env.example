# --- Runtime llama.cpp v2 (llama-server en mode router) ---
# Chemin de l'exécutable ; vide = découverte automatique
# (~/llama.cpp/build/bin/Release puis PATH).
LLAMA_SERVER_PATH=
LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_MODELS_MAX=2
LLAMA_STARTUP_TIMEOUT=120

# Modèles = profils du router (gemma-4-12b / gemma-4-e4b / gemma-4-e2b /
# gemma-4-12b-256k). Les alias Ollama historiques restent acceptés.
CHAT_MODEL=gemma-4-12b
FAST_MODEL=gemma-4-e4b
REASONING_MODEL=gemma-4-12b
CODING_MODEL=gemma-4-12b
VISION_MODEL=gemma-4-12b

# Optional live Web search. Sonar remains the grounded-answer provider.
# The orchestrator then routes to specialists and progressively falls back
# through SearXNG, Brave, Tavily and DuckDuckGo as evidence requires.
PERPLEXITY_API_KEY=
PERPLEXITY_SONAR_MODEL=sonar
BRAVE_SEARCH_API_KEY=
SEARXNG_ENABLED=false
SEARXNG_BASE_URL=http://127.0.0.1:8080
TAVILY_API_KEY=

# Free specialist routes. GDELT and Wikimedia do not need a key.
# OpenAlex requires a free key from https://openalex.org/settings/api.
SEARCH_SPECIALISTS_ENABLED=true
OPENALEX_API_KEY=

# Required for API calls arriving through Cloudflared or another proxy.
LASME_ACCESS_TOKEN=

# Coding routes are local-only by default, even with a valid token.
LASME_ALLOW_REMOTE_CODING=false
LASME_ALLOW_DESTRUCTIVE_AGENT_TOOLS=false
LASME_ENABLE_AGENT_TERMINAL=false
LASME_WORKSPACE_ROOT=C:\Users\lasme\Desktop\projects\lasme-llm
LASME_ALLOWED_COMMANDS=

# Image generation uses an external provider and is therefore not private.
LASME_ENABLE_EXTERNAL_IMAGE_GENERATION=true
LASME_PUBLIC_BASE_URL=
LASME_MAX_UPLOAD_BYTES=26214400

# Optional override when Docker Desktop is not present in PATH.
LASME_DOCKER_BINARY=
