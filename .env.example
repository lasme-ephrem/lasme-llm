OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=gemma-4-chat
CODING_MODEL=gemma-4-fable
REASONING_MODEL=gemma-4-fable

# Optional. Leave empty until a compatible Ollama vision model is installed.
VISION_MODEL=

# Optional live Web search. DuckDuckGo remains available as fallback.
TAVILY_API_KEY=

# Required for API calls arriving through Cloudflared or another proxy.
LASME_ACCESS_TOKEN=replace-with-a-long-random-token

# Coding routes are local-only by default, even with a valid token.
LASME_ALLOW_REMOTE_CODING=false
LASME_ALLOW_DESTRUCTIVE_AGENT_TOOLS=false
LASME_WORKSPACE_ROOT=C:\Users\lasme\Desktop\projects\lasme-llm

# Image generation uses an external provider and is therefore not private.
LASME_ENABLE_EXTERNAL_IMAGE_GENERATION=true
LASME_PUBLIC_BASE_URL=
LASME_MAX_UPLOAD_BYTES=10485760
